// ---------- Constants ----------

private const val STEP_LENGTH_METERS = 0.15f

fun hasStepPermission(context: Context): Boolean {
    return if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) {
        true
    } else {
        ContextCompat.checkSelfPermission(
            context, Manifest.permission.ACTIVITY_RECOGNITION
        ) == PackageManager.PERMISSION_GRANTED
    }
}

// ---------- Data / state types ----------

enum class MotionState { MOVING, STILL }

data class ParkingEvent(val timestamp: Long)

data class AccelerometerReading(
    val x: Float,
    val y: Float,
    val z: Float,
    val deviation: Float,
    val isStill: Boolean
)

enum class SensitivityLevel(val threshold: Float, val label: String) {
    LOW(8.0f, "Low"),
    MEDIUM(4.0f, "Medium"),
    HIGH(1.5f, "High")
}

