// ---------- ViewModel ----------

class ParkingViewModel : ViewModel() {

    private var sensorManager: SensorManager? = null

    // --- Feature 1: parking detection ---
    private val _motionState = MutableStateFlow(MotionState.STILL)
    val motionState: StateFlow<MotionState> = _motionState.asStateFlow()

    private val _parkingEvents = MutableStateFlow<List<ParkingEvent>>(emptyList())
    val parkingEvents: StateFlow<List<ParkingEvent>> = _parkingEvents.asStateFlow()

    private val _sensitivity = MutableStateFlow(SensitivityLevel.MEDIUM)
    val sensitivity: StateFlow<SensitivityLevel> = _sensitivity.asStateFlow()

    private val _lastReading = MutableStateFlow<AccelerometerReading?>(null)
    val lastReading: StateFlow<AccelerometerReading?> = _lastReading.asStateFlow()

    private val _pendingParkingConfirmation = MutableStateFlow(false)
    val pendingParkingConfirmation: StateFlow<Boolean> = _pendingParkingConfirmation.asStateFlow()

    private var pendingParkingTimestamp: Long = 0L
    private var wasMoving = false
    private var stillSinceMillis: Long? = null
    private val PARKING_STILL_DURATION_MS = 1500L

    // --- Feature 2: step counting / distance from car ---
    private val _showStepOption = MutableStateFlow(false)
    val showStepOption: StateFlow<Boolean> = _showStepOption.asStateFlow()

    private val _isStepTrackingActive = MutableStateFlow(false)
    val isStepTrackingActive: StateFlow<Boolean> = _isStepTrackingActive.asStateFlow()

    private val _stepsAwayFromCar = MutableStateFlow(0)
    val stepsAwayFromCar: StateFlow<Int> = _stepsAwayFromCar.asStateFlow()

    private val _hasStepResult = MutableStateFlow(false)
    val hasStepResult: StateFlow<Boolean> = _hasStepResult.asStateFlow()

    private var lastTotalSteps: Int? = null
    private var stepsAtTrackingStart: Int? = null

    private val motionListener = object : SensorEventListener {
        override fun onSensorChanged(event: SensorEvent) {
            val x = event.values[0]
            val y = event.values[1]
            val z = event.values[2]
            val magnitude = sqrt(x * x + y * y + z * z)
            val deviation = magnitude - SensorManager.GRAVITY_EARTH
            val isStillNow = kotlin.math.abs(deviation) < _sensitivity.value.threshold

            // always keep motion state / diagnostics live, even while parking
            // re-detection below is paused
            _lastReading.value = AccelerometerReading(x, y, z, deviation, isStillNow)
            _motionState.value = if (isStillNow) MotionState.STILL else MotionState.MOVING

            if (_pendingParkingConfirmation.value || _showStepOption.value) {
                // waiting on the user, or already confirmed parked (whether or not
                // step tracking has actually started yet) - stay paused either way
                stillSinceMillis = null
                wasMoving = false
                return
            }

            if (isStillNow) {
                if (wasMoving) {
                    if (stillSinceMillis == null) stillSinceMillis = System.currentTimeMillis()
                    val heldLongEnough =
                        System.currentTimeMillis() - stillSinceMillis!! >= PARKING_STILL_DURATION_MS
                    if (heldLongEnough) {
                        pendingParkingTimestamp = System.currentTimeMillis()
                        _pendingParkingConfirmation.value = true
                        wasMoving = false
                        stillSinceMillis = null
                    }
                }
            } else {
                wasMoving = true
                stillSinceMillis = null
            }
        }

        override fun onAccuracyChanged(sensor: Sensor?, accuracy: Int) {}
    }

    private val stepListener = object : SensorEventListener {
        override fun onSensorChanged(event: SensorEvent) {
            val totalSteps = event.values[0].toInt()
            lastTotalSteps = totalSteps
            if (_isStepTrackingActive.value) {
                if (stepsAtTrackingStart == null) {
                    stepsAtTrackingStart = totalSteps
                }
                _stepsAwayFromCar.value = totalSteps - (stepsAtTrackingStart ?: totalSteps)
            }
        }

        override fun onAccuracyChanged(sensor: Sensor?, accuracy: Int) {}
    }

    fun confirmParkingEvent() {
        _parkingEvents.value = _parkingEvents.value + ParkingEvent(pendingParkingTimestamp)
        _pendingParkingConfirmation.value = false
        _showStepOption.value = true
    }

    fun dismissParkingEvent() {
        _pendingParkingConfirmation.value = false
    }

    fun startStepTracking() {
        stepsAtTrackingStart = null   // captured from the next real sensor reading
        _stepsAwayFromCar.value = 0
        _isStepTrackingActive.value = true
        _hasStepResult.value = true
    }

    fun stopStepTracking() {
        _isStepTrackingActive.value = false
        _showStepOption.value = false
        wasMoving = false
        stillSinceMillis = null
        // note: stepsAwayFromCar / hasStepResult are intentionally left alone here -
        // stopping tracking should not erase what was recorded
    }

    fun clearStepResult() {
        _stepsAwayFromCar.value = 0
        _hasStepResult.value = false
    }

    fun setSensitivity(level: SensitivityLevel) {
        _sensitivity.value = level
    }

    fun clearHistory() {
        _parkingEvents.value = emptyList()
    }

    private fun ensureSensorManager(context: Context): SensorManager {
        if (sensorManager == null) {
            sensorManager = context.getSystemService(Context.SENSOR_SERVICE) as SensorManager
        }
        return sensorManager!!
    }

    fun startListening(context: Context) {
        val sm = ensureSensorManager(context)
        val accelerometer = sm.getDefaultSensor(Sensor.TYPE_ACCELEROMETER)
        sm.registerListener(motionListener, accelerometer, SensorManager.SENSOR_DELAY_UI)
    }

    fun stopListening() {
        sensorManager?.unregisterListener(motionListener)
    }

    fun startStepListening(context: Context) {
        val sm = ensureSensorManager(context)
        val stepCounter = sm.getDefaultSensor(Sensor.TYPE_STEP_COUNTER)
        sm.registerListener(stepListener, stepCounter, SensorManager.SENSOR_DELAY_UI)
    }

    fun stopStepListening() {
        sensorManager?.unregisterListener(stepListener)
    }
}

// ---------- Activity ----------

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContent {
            Lect6SensorsLocationTheme {
                ParkTrackApp()
            }
        }
    }
}

// ---------- Navigation host ----------

@Composable
fun ParkTrackApp() {
    val navController = rememberNavController()
    val viewModel: ParkingViewModel = viewModel()

    NavHost(navController = navController, startDestination = Start) {
        composable<Start> {
            StartScreen(
                viewModel = viewModel,
                onStart = {
                    navController.navigate(Main) {
                        popUpTo(Start) { inclusive = true }
                    }
                }
            )
        }
        composable<Main> {
            MainScreen(
                viewModel = viewModel,
                onViewHistory = { navController.navigate(History) }
            )
        }
        composable<History> {
            HistoryScreen(
                viewModel = viewModel,
                onBack = { navController.popBackStack() }
            )
        }
    }
}

// ---------- Start screen ----------

@Composable
fun StartScreen(viewModel: ParkingViewModel, onStart: () -> Unit) {
    val sensitivity by viewModel.sensitivity.collectAsState()

    Column(
        modifier = Modifier
            .fillMaxSize()
            .padding(24.dp),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center
    ) {
        Image(
            painter = painterResource(R.drawable.ic_launcher_foreground),
            contentDescription = "ParkTrack logo",
            modifier = Modifier.size(120.dp)
        )
        Spacer(modifier = Modifier.height(16.dp))
        Text("ParkTrack", style = MaterialTheme.typography.headlineMedium)
        Text(
            "Automatically detects when you've parked",
            style = MaterialTheme.typography.bodyMedium
        )

        Spacer(modifier = Modifier.height(32.dp))
        Text("Parking-detection sensitivity", style = MaterialTheme.typography.titleMedium)
        Spacer(modifier = Modifier.height(8.dp))

        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
            SensitivityLevel.entries.forEach { level ->
                Button(
                    onClick = { viewModel.setSensitivity(level) },
                    enabled = sensitivity != level
                ) {
                    Text(level.label)
                }
            }
        }

        Spacer(modifier = Modifier.height(32.dp))
        Button(onClick = onStart) {
            Text("Start Monitoring")
        }
    }
}

// ---------- Main (monitoring) screen ----------

@Composable
fun MainScreen(viewModel: ParkingViewModel, onViewHistory: () -> Unit) {
    val context = LocalContext.current
    val motionState by viewModel.motionState.collectAsState()
    val parkingEvents by viewModel.parkingEvents.collectAsState()
    val lastReading by viewModel.lastReading.collectAsState()
    val pendingConfirmation by viewModel.pendingParkingConfirmation.collectAsState()
    val showStepOption by viewModel.showStepOption.collectAsState()
    val isStepTrackingActive by viewModel.isStepTrackingActive.collectAsState()
    val stepsAwayFromCar by viewModel.stepsAwayFromCar.collectAsState()
    val hasStepResult by viewModel.hasStepResult.collectAsState()
    var showDiagnostics by remember { mutableStateOf(false) }
    var hasStepPerm by remember { mutableStateOf(hasStepPermission(context)) }

    val permissionLauncher = rememberLauncherForActivityResult(
        ActivityResultContracts.RequestPermission()
    ) { granted ->
        hasStepPerm = granted
        if (granted) viewModel.startStepTracking()
    }

    DisposableEffect(Unit) {
        viewModel.startListening(context)
        onDispose { viewModel.stopListening() }
    }

    DisposableEffect(hasStepPerm) {
        if (hasStepPerm) viewModel.startStepListening(context)
        onDispose { viewModel.stopStepListening() }
    }

    if (pendingConfirmation) {
        AlertDialog(
            onDismissRequest = { viewModel.dismissParkingEvent() },
            title = { Text("Parking detected") },
            text = { Text("It looks like you've parked. Confirm?") },
            confirmButton = {
                Button(onClick = { viewModel.confirmParkingEvent() }) { Text("Yes, parked") }
            },
            dismissButton = {
                Button(onClick = { viewModel.dismissParkingEvent() }) { Text("Not yet") }
            }
        )
    }

    val statusText = when {
        motionState == MotionState.MOVING -> "Moving"
        isStepTrackingActive -> "Stationary"
        else -> "Parked"
    }

    Box(modifier = Modifier.fillMaxSize()) {
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(24.dp),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.Center
        ) {
            Text(text = statusText, style = MaterialTheme.typography.headlineMedium)
            Spacer(modifier = Modifier.height(16.dp))
            Text("Parking events recorded: ${parkingEvents.size}")

            if (showStepOption || hasStepResult) {
                Spacer(modifier = Modifier.height(24.dp))
                Text("Steps taken: $stepsAwayFromCar")
                Text(
                    "Estimated distance from car: %.1f m".format(
                        stepsAwayFromCar * STEP_LENGTH_METERS
                    )
                )
                Spacer(modifier = Modifier.height(8.dp))
                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                    if (showStepOption) {
                        Button(onClick = {
                            when {
                                isStepTrackingActive -> viewModel.stopStepTracking()
                                hasStepPerm -> viewModel.startStepTracking()
                                else -> permissionLauncher.launch(Manifest.permission.ACTIVITY_RECOGNITION)
                            }
                        }) {
                            Text(if (isStepTrackingActive) "Stop Tracking" else "Start Step & Distance Tracking")
                        }
                    }
                    if (hasStepResult) {
                        Button(onClick = { viewModel.clearStepResult() }) {
                            Text("Clear")
                        }
                    }
                }
            }

            Spacer(modifier = Modifier.height(24.dp))
            Button(onClick = onViewHistory) { Text("View History") }

            Spacer(modifier = Modifier.height(12.dp))
            Button(onClick = { showDiagnostics = !showDiagnostics }) {
                Text(if (showDiagnostics) "Hide Diagnostics" else "Show Diagnostics")
            }
        }

        if (showDiagnostics && lastReading != null) {
            val reading = lastReading!!
            Text(
                text = "x: %.2f  y: %.2f  z: %.2f\ndeviation: %.2f".format(
                    reading.x, reading.y, reading.z, reading.deviation
                ),
                color = if (reading.isStill) Color.Black else Color.Red,
                modifier = Modifier
                    .align(Alignment.TopEnd)
                    .padding(12.dp)
            )
        }
    }
}

// ---------- History screen ----------

@Composable
fun HistoryScreen(viewModel: ParkingViewModel, onBack: () -> Unit) {
    val parkingEvents by viewModel.parkingEvents.collectAsState()
    val formatter = remember { SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.getDefault()) }

    Column(modifier = Modifier.fillMaxSize().padding(16.dp)) {
        Text("Parking History", style = MaterialTheme.typography.headlineSmall)
        Spacer(modifier = Modifier.height(16.dp))

        LazyColumn(modifier = Modifier.weight(1f)) {
            items(parkingEvents) { event ->
                Text(
                    text = formatter.format(Date(event.timestamp)),
                    modifier = Modifier.padding(vertical = 8.dp)
                )
            }
        }

        Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
            Button(onClick = onBack) { Text("Back") }
            Button(onClick = { viewModel.clearHistory() }) { Text("Clear History") }
        }
    }
}
