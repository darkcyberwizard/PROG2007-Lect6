// ---------- Model ----------

enum class MotionState { MOVING, STILL }

data class ParkingEvent(val timestamp: Long)

enum class SensitivityLevel(val threshold: Float, val label: String) {
    LOW(4.0f, "Low"),
    MEDIUM(2.0f, "Medium"),
    HIGH(1.0f, "High")
}

// ---------- Routes ----------

@Serializable
object Start

@Serializable
object Main

@Serializable
object History

// ---------- ViewModel ----------

class ParkingViewModel : ViewModel() {

    private val _motionState = MutableStateFlow(MotionState.MOVING)
    val motionState: StateFlow<MotionState> = _motionState

    private val _parkingEvents = MutableStateFlow<List<ParkingEvent>>(emptyList())
    val parkingEvents: StateFlow<List<ParkingEvent>> = _parkingEvents

    private val _sensitivity = MutableStateFlow(SensitivityLevel.MEDIUM)
    val sensitivity: StateFlow<SensitivityLevel> = _sensitivity

    private var sensorManager: SensorManager? = null

    // Starts false: a park can only be logged after a genuine moving -> still
    // transition, never on the very first reading the app happens to see.
    private var wasMoving = false

    private val listener = object : SensorEventListener {
        override fun onSensorChanged(event: SensorEvent) {
            val (x, y, z) = event.values
            val deviation = sqrt(x * x + y * y + z * z) - SensorManager.GRAVITY_EARTH
            val isStillNow = abs(deviation) < _sensitivity.value.threshold

            _motionState.value = if (isStillNow) MotionState.STILL else MotionState.MOVING

            if (wasMoving && isStillNow) {
                onParkingDetected()
            }
            wasMoving = !isStillNow
        }

        override fun onAccuracyChanged(sensor: Sensor, accuracy: Int) {}
    }

    private fun onParkingDetected() {
        _parkingEvents.value = _parkingEvents.value + ParkingEvent(System.currentTimeMillis())
    }

    fun startListening(context: Context) {
        val manager = context.getSystemService(Context.SENSOR_SERVICE) as SensorManager
        sensorManager = manager
        val accelerometer = manager.getDefaultSensor(Sensor.TYPE_ACCELEROMETER)
        if (accelerometer != null) {
            manager.registerListener(listener, accelerometer, SensorManager.SENSOR_DELAY_UI)
        }
    }

    fun stopListening() {
        sensorManager?.unregisterListener(listener)
    }

    fun clearHistory() {
        _parkingEvents.value = emptyList()
    }

    fun setSensitivity(level: SensitivityLevel) {
        _sensitivity.value = level
    }
}

// ---------- App / Navigation ----------

@Composable
fun ParkTrackApp() {
    val navController = rememberNavController()
    val viewModel: ParkingViewModel = viewModel()

    NavHost(navController = navController, startDestination = Start) {
        composable<Start> {
            StartScreen(onStart = { navController.navigate(Main) })
        }
        composable<Main> {
            MainScreen(
                viewModel = viewModel,
                onViewHistory = { navController.navigate(History) }
            )
        }
        composable<History> {
            HistoryScreen(
                viewModel = viewModel,
                onBack = { navController.popBackStack() }
            )
        }
    }
}

// ---------- Screens ----------

@Composable
fun StartScreen(onStart: () -> Unit) {
    Column(
        modifier = Modifier.fillMaxSize().padding(24.dp),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center
    ) {
        Image(
            painter = painterResource(id = R.drawable.ic_launcher_foreground),
            contentDescription = "ParkTrack logo",
            modifier = Modifier.size(160.dp)
        )
        Spacer(modifier = Modifier.height(16.dp))
        Text(text = "ParkTrack", style = MaterialTheme.typography.headlineMedium)
        Text(text = "Never forget where you parked.")
        Spacer(modifier = Modifier.height(24.dp))
        Button(onClick = onStart) { Text("Start Monitoring") }
    }
}

@Composable
fun MainScreen(
    viewModel: ParkingViewModel,
    onViewHistory: () -> Unit
) {
    val context = LocalContext.current
    val motionState by viewModel.motionState.collectAsState()
    val events by viewModel.parkingEvents.collectAsState()
    val sensitivity by viewModel.sensitivity.collectAsState()

    DisposableEffect(Unit) {
        viewModel.startListening(context)
        onDispose { viewModel.stopListening() }
    }

    Column(
        modifier = Modifier.fillMaxSize().padding(24.dp),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center
    ) {
        Text(
            text = if (motionState == MotionState.STILL) "Parked" else "Moving",
            style = MaterialTheme.typography.headlineMedium
        )
        Spacer(modifier = Modifier.height(8.dp))
        Text(text = "Parking events detected: ${events.size}")
        Spacer(modifier = Modifier.height(24.dp))

        Text(text = "Sensitivity")
        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
            SensitivityLevel.entries.forEach { level ->
                if (level == sensitivity) {
                    Button(onClick = { viewModel.setSensitivity(level) }) { Text(level.label) }
                } else {
                    OutlinedButton(onClick = { viewModel.setSensitivity(level) }) { Text(level.label) }
                }
            }
        }

        Spacer(modifier = Modifier.height(24.dp))
        Button(onClick = onViewHistory) { Text("View History") }
    }
}

@Composable
fun HistoryScreen(
    viewModel: ParkingViewModel,
    onBack: () -> Unit
) {
    val events by viewModel.parkingEvents.collectAsState()
    val formatter = remember { SimpleDateFormat("HH:mm:ss", Locale.getDefault()) }

    Column(modifier = Modifier.fillMaxSize().padding(24.dp)) {
        Text(text = "Parking History", style = MaterialTheme.typography.headlineSmall)
        Spacer(modifier = Modifier.height(16.dp))

        LazyColumn(modifier = Modifier.weight(1f)) {
            items(events) { event ->
                Text(
                    text = "Parked at ${formatter.format(Date(event.timestamp))}",
                    modifier = Modifier.padding(vertical = 8.dp)
                )
            }
        }

        Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
            Button(onClick = onBack) { Text("Back") }
            OutlinedButton(onClick = { viewModel.clearHistory() }) { Text("Clear History") }
        }
    }
}

